# Deaddit environment configuration.
# Copy to `.env` next to docker-compose.yml; docker compose loads it via `env_file`.
# Every variable is optional — unset values fall back to in-app defaults.

# Bearer token guarding admin/API routes. Unset = routes publicly accessible (warned at startup).
API_TOKEN=

# Flask session signing key. Change this in any real deployment.
SECRET_KEY=

# OpenAI-compatible API key used for content generation.
OPENAI_KEY=

# Log level for the application log (DEBUG/INFO/WARNING/ERROR). Default: INFO.
DEADDIT_LOG_LEVEL=INFO

# Host port the web service binds to (container always listens on 5000).
DEADDIT_WEB_PORT=5000

# Worker process tuning (used by the deaddit-worker entrypoint).
# Seconds between job-poll iterations.
DEADDIT_WORKER_POLL_SECONDS=2.0
# Seconds between liveness heartbeats (Setting row + heartbeat file).
DEADDIT_WORKER_HEARTBEAT_SECONDS=30
# Minutes without a heartbeat before a worker is considered stale.
DEADDIT_WORKER_STALE_MINUTES=5
# Number of jobs processed concurrently per poll lane.
DEADDIT_WORKER_LANE_SIZE=2
