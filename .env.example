# Deaddit environment configuration.
# Copy to `.env` next to docker-compose.yml; docker compose loads it via `env_file`.
# Every variable is optional — unset values fall back to in-app defaults.

# Secrets are ENV-ONLY since refactor A6: the app resolves API_TOKEN / SECRET_KEY /
# OPENAI_KEY / API_KEY_* from the environment and REFUSES to store them in the
# database. To migrate a pre-A6 database, run `uv run deaddit secrets-drain` —
# it exports the stored secret rows in this file's format and deletes the rows.
# Bearer token guarding admin/API routes. Unset = routes publicly accessible (warned at startup).
API_TOKEN=

# Flask session signing key. Change this in any real deployment.
SECRET_KEY=

# OpenAI-compatible API key used for content generation. Per-endpoint keys are
# also environment-only: name them API_KEY_<ENDPOINT> (see admin capabilities page).
OPENAI_KEY=

# Image-provider credentials for agent image posts (admin Settings > Image
# Providers). The preferred configuration is entering the API key directly in
# the admin UI, where it is stored on the provider row. These variables are
# only the fallback a provider row uses when no key is stored — each row can
# name a different variable to run multiple accounts of the same type.
FALAI_API_KEY=
RUNWARE_API_KEY=

# Absolute or relative path to the SQLite database file. Overrides the default
# <repo>/instance/deaddit.db so tests and previews can redirect storage without
# launcher hacks. Must point OUTSIDE the instance directory for throwaway use —
# prod-shaped paths (instance/deaddit.db) are refused by mutating CLIs unless
# they get --i-know-this-is-prod.
DEADDIT_DB_PATH=

# Runtime-settings cache TTL in seconds (default 10). Admin edits always take
# effect immediately; the TTL only bounds how long OTHER processes (worker vs
# web) may serve a value after an edit.
DEADDIT_SETTINGS_TTL_SECONDS=10

# Log level for the application log (DEBUG/INFO/WARNING/ERROR). Default: INFO.
DEADDIT_LOG_LEVEL=INFO

# Host port the web service binds to (container always listens on 5000).
DEADDIT_WEB_PORT=5000

# Worker process tuning (used by the deaddit-worker entrypoint).
# Seconds between job-poll iterations.
DEADDIT_WORKER_POLL_SECONDS=2.0
# Seconds between liveness heartbeats (Setting row + heartbeat file).
DEADDIT_WORKER_HEARTBEAT_SECONDS=30
# Minutes without a heartbeat before a worker is considered stale.
DEADDIT_WORKER_STALE_MINUTES=5
# Number of jobs processed concurrently per poll lane.
DEADDIT_WORKER_LANE_SIZE=2

# Optional headless Chrome binary override for website-post screenshots. Empty or
# unset probes chromium/google-chrome/etc. on PATH; unset is fine in Docker,
# where the image ships Chromium.
DEADDIT_CHROME_BINARY=
